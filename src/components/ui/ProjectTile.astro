---
import type { GalleryProject } from '../../data/project-gallery';
type Props = GalleryProject;
const { title, href, technologies, preview } = Astro.props;
---
<a class="glass project-tile" href={href} target="_blank" rel="noopener noreferrer" aria-label={`Ver ${title} (abre en otra pestaña)`}>
  <h3>{title}</h3>
  <div class="tile-preview" aria-hidden="true">
    {preview ? <img src={preview} alt="" loading="lazy" decoding="async" width="480" height="300" /> : <div class="preview-placeholder"><span class="preview-bar"><i></i><i></i><i></i></span><span class="preview-label">Preview</span></div>}
  </div>
  <p class="tile-technologies">{technologies.length ? technologies.join(' / ') : 'Demo web / Enlace público'}</p>
  <span class="tile-arrow" aria-hidden="true">→</span>
</a>

<style>
  .project-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    padding: 32px 28px 22px;
    border-radius: var(--radius);
    transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease;
  }
  h3 {
    font-family: var(--mono);
    font-size: .73rem;
    font-weight: 400;
    letter-spacing: .15em;
    line-height: 1.5;
    text-align: center;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .tile-preview { width: 100%; padding: 32px 12px; }
  .tile-preview img, .preview-placeholder {
    width: 100%;
    aspect-ratio: 8 / 5;
    border: 1px solid #ffffff20;
    border-radius: 12px;
    background: linear-gradient(145deg, #ffffff08, #ffffff01);
    box-shadow: inset 0 1px 0 #ffffff0c, 0 12px 28px #00000024;
    transition: transform .35s ease, border-color .35s ease;
  }
  .tile-preview img { height: auto; object-fit: cover; filter: grayscale(1); }
  .preview-placeholder { display: flex; flex-direction: column; }
  .preview-bar { height: 22px; display: flex; align-items: center; gap: 4px; padding-inline: 10px; border-bottom: 1px solid #ffffff0a; }
  .preview-bar i { width: 3px; height: 3px; border-radius: 50%; background: #ffffff2b; }
  .preview-label { flex: 1; display: grid; place-items: center; padding-bottom: 10px; font-family: var(--mono); font-size: .6rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .tile-technologies { width: 100%; margin-top: auto; font-family: var(--mono); font-size: .61rem; line-height: 1.8; text-transform: uppercase; letter-spacing: .05em; overflow-wrap: anywhere; }
  .tile-arrow { align-self: end; margin-top: 18px; color: #c8c8c4; font-size: 1.5rem; line-height: 1; transition: transform .3s ease; }
  .project-tile:focus-visible { outline: 2px solid var(--text); outline-offset: 5px; border-color: #ffffff50; }
  .project-tile:focus-visible .tile-arrow { transform: translateX(4px); }
  @media (hover: hover) {
    .project-tile:hover { transform: translateY(-4px); border-color: #ffffff35; box-shadow: inset 0 1px 0 #ffffff15, 0 22px 48px #00000024; }
    .project-tile:hover .preview-placeholder, .project-tile:hover img { transform: translateY(-2px); border-color: #ffffff33; }
    .project-tile:hover .tile-arrow { transform: translateX(4px); }
  }
  @media (max-width: 640px) { .project-tile { padding: 28px 24px 22px; } }
</style>
