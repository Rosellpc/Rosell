---
import type { CollectionEntry } from 'astro:content';
import GlassCard from './GlassCard.astro';
interface Props { project: CollectionEntry<'projects'>; index: number; }
const { project, index } = Astro.props;
---
<GlassCard class="project-card">
  <div class="project-art" aria-hidden="true">
    <div class="architecture-node">Interfaz <span>{project.data.architecture[0]}</span></div>
    <div class="architecture-line"></div>
    <div class="architecture-node main-node">API <span>{project.data.architecture[1]}</span></div>
    <div class="architecture-line"></div>
    <div class="architecture-node">{project.id === 'restaurantos' ? 'Datos' : 'Acceso'} <span>{project.data.architecture[2]}</span></div>
    <span class="art-caption">Sistema / {String(index + 1).padStart(2, '0')}</span>
  </div>
  <div class="project-copy">
    <p class="eyebrow">{project.data.category}</p>
    <h3><a href={`/proyectos/${project.id}/`}>{project.data.title}<span class="project-arrow" aria-hidden="true">↗</span></a></h3>
    <p>{project.data.description}</p>
    {project.data.contribution && <p class="project-contribution"><strong>Mi aporte:</strong> {project.data.contribution}</p>}
    {project.data.status && <p class="project-status">{project.data.status}</p>}
    <ul class="tags" aria-label="Tecnologías">{project.data.technologies.map(item => <li>{item}</li>)}</ul>
    <a class="text-link" href={`/proyectos/${project.id}/`}>Explorar proyecto <span aria-hidden="true">↗</span></a>
  </div>
</GlassCard>
