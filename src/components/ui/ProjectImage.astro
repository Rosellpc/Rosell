---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: string; alt: string; detail?: boolean; }
const { src, alt, detail = false } = Astro.props;
const assets = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/*.{png,jpg}', { eager: true });
const asset = assets[`../../assets/projects/${src.split('/').pop()}`]?.default;
if (!asset) throw new Error(`Captura no encontrada: ${src}`);
---
<Image src={asset} alt={alt} widths={detail ? [640, 1120, 1920] : [320, 480, 720]} sizes={detail ? '(max-width: 1188px) calc(100vw - 48px), 1140px' : '(max-width: 640px) calc(100vw - 96px), (max-width: 900px) 40vw, 320px'} width={detail ? 1120 : 480} format="webp" quality={80} loading="lazy" decoding="async" class:list={{ 'project-detail-preview': detail }} />
