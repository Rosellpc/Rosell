---
import { profile } from '../../data/profile';
import SocialIcon from '../ui/SocialIcon.astro';
const inLab = Astro.url.pathname.startsWith('/lab');
---
<footer class="site-footer">
  <nav class="footer-socials" aria-label="Redes y contacto">
    {profile.socials.map(social => <a href={social.url} aria-label={social.label} title={social.label} target="_blank" rel="noopener noreferrer"><SocialIcon label={social.label} size={18} /></a>)}
  </nav>
  <a class="footer-lab" href="/lab/vortex/" aria-label="Laboratorio" title="Laboratorio" aria-current={inLab ? 'page' : undefined}>
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v7L4 19a1 1 0 0 0 1 2h14a1 1 0 0 0 1-2l-6-9V3M8 15h8" /></svg>
    <span class="footer-label">Laboratorio</span>
  </a>
  <a class="footer-top" href="#contenido" aria-label="Volver arriba" title="Volver arriba"><span class="up-icon" aria-hidden="true">↑</span><span class="footer-label">Volver arriba</span></a>
  <p class="footer-copy">© {new Date().getFullYear()} <span>{profile.name}</span></p>
</footer>
