---
import { Image } from 'astro:assets';
import portrait from '../../assets/profile/foto-profile-transparent.png';
const particles = Array.from({ length: 12 }, (_, i) => ({
  x: 12 + ((i * 31) % 78), y: 15 + ((i * 23) % 70), delay: -(i * 1.3),
}));
---

<holographic-portrait data-running="false">
  <div class="hologram-stage">
    <div class="ambient-glow" aria-hidden="true"></div>
    <div class="portrait-plane">
      <Image src={portrait} alt="" aria-hidden="true" width={640} format="webp" quality={80} class="portrait-aura" />
      <Image src={portrait} alt="Retrato de Rosell dentro de un cubo holográfico" width={800} widths={[400, 640, 960]} sizes="(max-width: 760px) 65vw, 360px" format="webp" quality={85} loading="eager" fetchpriority="high" class="hologram-photo" />
      <div class="scan-texture" aria-hidden="true"></div>
    </div>
    <div class="hologram-float">
      <div class="hologram-cube">
        <div class="cube-face face-back" aria-hidden="true"></div>
        <div class="cube-face face-left" aria-hidden="true"></div>
        <div class="cube-face face-right" aria-hidden="true"></div>
        <div class="cube-face face-top" aria-hidden="true"></div>
        <div class="cube-face face-bottom" aria-hidden="true"></div>
        <div class="projection-ring" aria-hidden="true"></div>
        <div class="scan-plane" aria-hidden="true"></div>
        <div class="cube-face face-front" aria-hidden="true"></div>
      </div>
    </div>
    <div class="particles" aria-hidden="true">
      {particles.map(p => <i style={`--x:${p.x}%;--y:${p.y}%;--delay:${p.delay}s`}></i>)}
    </div>
  </div>
</holographic-portrait>

<style>
  holographic-portrait {
    display: block;
    position: relative;
    width: min(100%, 520px);
    container-type: inline-size;
    --glow: 192, 222, 226;
    --cycle-duration: 32s;
    --portrait-blur: 2px;
  }
  .hologram-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.06;
    perspective: 1100px;
    isolation: isolate;
  }
  .ambient-glow {
    position: absolute;
    inset: 5% -3%;
    background: radial-gradient(ellipse, rgba(var(--glow), .09), transparent 65%);
    pointer-events: none;
  }
  .hologram-float {
    position: absolute;
    width: 64%;
    height: 60.38%;
    top: 19%;
    left: 18%;
    transform-style: preserve-3d;
    animation: cube-turn var(--cycle-duration) linear infinite;
  }
  .hologram-cube {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(calc(-9deg + var(--tilt-x, 0deg))) rotateY(calc(-18deg + var(--tilt-y, 0deg)));
    transition: transform .55s ease-out;
  }
  .cube-face {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(var(--glow), .38);
    background: linear-gradient(135deg, rgba(var(--glow), .025), transparent 60%);
    box-shadow: inset 0 0 22px rgba(var(--glow), .025), 0 0 9px rgba(var(--glow), .06);
    pointer-events: none;
  }
  .face-front { transform: translateZ(32cqw); border-color: rgba(var(--glow), .55); }
  .face-back { transform: rotateY(180deg) translateZ(32cqw); opacity: .45; }
  .face-left { transform: rotateY(-90deg) translateZ(32cqw); }
  .face-right { transform: rotateY(90deg) translateZ(32cqw); }
  .face-top { transform: rotateX(90deg) translateZ(32cqw); }
  .face-bottom { transform: rotateX(-90deg) translateZ(32cqw); }
  .portrait-plane {
    position: absolute;
    /* A sibling of the animated cube: neither rotation nor cursor tilt moves the portrait. */
    top: 17.8%;
    left: 14%;
    width: 72%;
    height: 61.6%;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 55%, transparent 100%);
  }
  .hologram-photo, .portrait-aura {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }
  .hologram-photo {
    filter: grayscale(1) contrast(1.02) brightness(1.15) blur(0);
    opacity: .96;
    animation: portrait-focus var(--cycle-duration) linear infinite;
  }
  .portrait-aura { filter: grayscale(1) blur(18px); opacity: .08; transform: scale(1.06); animation: aura-focus var(--cycle-duration) linear infinite; }
  .scan-texture {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, transparent 0 4px, rgba(var(--glow), .045) 4px 5px);
    mask-image: radial-gradient(ellipse, #000, transparent 68%);
    pointer-events: none;
  }
  .scan-plane {
    position: absolute;
    inset: 0;
    transform: translateZ(33cqw);
    overflow: hidden;
    pointer-events: none;
  }
  .scan-plane::after {
    content: '';
    position: absolute;
    inset: 0;
    height: 18%;
    background: linear-gradient(transparent, rgba(var(--glow), .065));
    border-bottom: 1px solid rgba(var(--glow), .28);
    animation: scan 8s ease-in-out infinite;
  }
  .projection-ring {
    position: absolute;
    inset: 8%;
    border: 1px solid rgba(var(--glow), .4);
    border-radius: 50%;
    transform: translateY(32cqw) rotateX(90deg);
    box-shadow: 0 0 16px rgba(var(--glow), .1), inset 0 0 24px rgba(var(--glow), .08);
  }
  .projection-ring::after { content: ''; position: absolute; inset: 10%; border: 1px dashed rgba(var(--glow), .25); border-radius: 50%; }
  .particles { position: absolute; inset: 0; pointer-events: none; }
  .particles i {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: rgba(var(--glow), .7);
    box-shadow: 0 0 8px rgba(var(--glow), .45);
    opacity: .3;
    animation: drift 7s var(--delay) ease-in-out infinite;
  }
  .hologram-float, .hologram-photo, .portrait-aura, .particles i, .scan-plane::after { animation-play-state: paused; }
  [data-running='true'] .hologram-float, [data-running='true'] .hologram-photo, [data-running='true'] .portrait-aura, [data-running='true'] .particles i, [data-running='true'] .scan-plane::after { animation-play-state: running; }
  /* One shared cycle: two complete turns, first sharp and then defocused. */
  @keyframes cube-turn {
    0% { transform: translateY(0) rotateY(0deg); }
    25% { transform: translateY(-8px) rotateY(180deg); }
    50% { transform: translateY(0) rotateY(360deg); }
    75% { transform: translateY(-8px) rotateY(540deg); }
    100% { transform: translateY(0) rotateY(720deg); }
  }
  @keyframes portrait-focus {
    0%, 44%, 100% { filter: grayscale(1) contrast(1.02) brightness(1.15) blur(0); opacity: .96; }
    50%, 94% { filter: grayscale(1) contrast(1.02) brightness(1.15) blur(var(--portrait-blur)); opacity: .82; }
  }
  @keyframes aura-focus {
    0%, 44%, 100% { opacity: .08; }
    50%, 94% { opacity: .4; }
  }
  @keyframes scan { 0%, 100% { transform: translateY(-110%); opacity: 0; } 15%, 70% { opacity: 1; } 85% { transform: translateY(560%); opacity: 0; } }
  @keyframes drift { 0%, 100% { transform: translateY(5px); opacity: .1; } 50% { transform: translateY(-18px); opacity: .65; } }
  @media (max-width: 760px) {
    holographic-portrait { --cycle-duration: 40s; --portrait-blur: 1.5px; }
    .portrait-aura { filter: grayscale(1) blur(10px); }
    .particles i:nth-child(n+7) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hologram-float, .hologram-photo, .portrait-aura, .particles i, .scan-plane::after { animation: none; }
    .scan-plane { display: none; }
    .hologram-cube { transition: none; transform: rotateX(-9deg) rotateY(-18deg); }
  }
</style>

<script>
  class HolographicPortrait extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      const stage = this.querySelector<HTMLElement>('.hologram-stage')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const pointer = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 761px)');
      const events = new AbortController();
      let visible = false;
      let frame = 0;
      const reset = () => {
        cancelAnimationFrame(frame);
        this.style.removeProperty('--tilt-x');
        this.style.removeProperty('--tilt-y');
      };
      const sync = () => {
        this.dataset.running = String(visible && !document.hidden && !reduced.matches);
        if (this.dataset.running !== 'true' || !pointer.matches) reset();
      };
      const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }, { threshold: .1 });
      observer.observe(this);
      reduced.addEventListener('change', sync, { signal: events.signal });
      pointer.addEventListener('change', sync, { signal: events.signal });
      document.addEventListener('visibilitychange', sync, { signal: events.signal });
      stage.addEventListener('pointermove', event => {
        if (!pointer.matches || this.dataset.running !== 'true') return;
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const box = stage.getBoundingClientRect();
          const x = Math.max(-.5, Math.min(.5, (event.clientX - box.left) / box.width - .5));
          const y = Math.max(-.5, Math.min(.5, (event.clientY - box.top) / box.height - .5));
          this.style.setProperty('--tilt-x', `${-y * 8}deg`);
          this.style.setProperty('--tilt-y', `${x * 10}deg`);
        });
      }, { signal: events.signal });
      stage.addEventListener('pointerleave', reset, { signal: events.signal });
      sync();
      this.cleanup = () => { events.abort(); observer.disconnect(); reset(); };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('holographic-portrait')) customElements.define('holographic-portrait', HolographicPortrait);
</script>
