---
import MeteorShower from './MeteorShower.astro';
const stars = Array.from({ length: 120 }, () => ({
  x: Math.random() * 100,
  y: Math.random() * 100,
  size: 0.65 + Math.pow(Math.random(), 3) * 1.2,
  opacity: 0.2 + Math.pow(Math.random(), 2) * 0.55,
}));
---

<contact-cosmos>
  <div class="star-canvas" aria-hidden="true"></div>
  <div class="cosmos-field" aria-hidden="true">
    {
      stars.map((star) => (
        <i
          class="star"
          style={`left:${star.x}%;top:${star.y}%;width:${star.size}px;height:${star.size}px;opacity:${star.opacity}`}
        />
      ))
    }
  </div>
  <MeteorShower variant="contact" />
  <button
    type="button"
    aria-label="Pausar animación de contacto"
    aria-pressed="false"
    hidden>Pausar espacio Ⅱ</button
  >
</contact-cosmos>

<script>
  import type { createContactStars } from "../../graphics/vortex/contact-stars";
  class ContactCosmos extends HTMLElement {
    private starfield?: ReturnType<typeof createContactStars>;
    private loading = false;
    private observer?: IntersectionObserver;
    private motion = matchMedia("(prefers-reduced-motion: reduce)");
    private visible = false;
    private paused = false;
    private button?: HTMLButtonElement;
    connectedCallback() {
      this.button = this.querySelector("button")!;
      this.button.addEventListener("click", this.toggle);
      this.motion.addEventListener("change", this.sync);
      document.addEventListener("visibilitychange", this.sync);
      this.observer = new IntersectionObserver((entries) => {
        this.visible = entries[0].isIntersecting;
        this.sync();
      });
      this.observer.observe(this);
      this.sync();
    }
    disconnectedCallback() {
      this.starfield?.dispose();
      this.starfield = undefined;
      delete this.dataset.stars;
      this.observer?.disconnect();
      this.button?.removeEventListener("click", this.toggle);
      this.motion.removeEventListener("change", this.sync);
      document.removeEventListener("visibilitychange", this.sync);
    }
    private toggle = () => {
      this.paused = !this.paused;
      this.sync();
    };
    private async startStars() {
      if (this.loading || this.starfield || this.dataset.stars === "fallback")
        return;
      this.loading = true;
      try {
        const { createContactStars } =
          await import("../../graphics/vortex/contact-stars");
        if (!this.isConnected || this.motion.matches) return;
        this.starfield = createContactStars(
          this.querySelector(".star-canvas")!,
          () => {
            this.starfield?.dispose();
            this.starfield = undefined;
            this.dataset.stars = "fallback";
          },
        );
        this.dataset.stars = "ready";
        this.sync();
      } catch {
        this.dataset.stars = "fallback";
      } finally {
        this.loading = false;
      }
    }
    private sync = () => {
      this.dataset.state = this.motion.matches
        ? "static"
        : this.paused
          ? "paused"
          : this.visible && !document.hidden
            ? "running"
            : "idle";
      if (this.motion.matches) {
        this.starfield?.dispose();
        this.starfield = undefined;
        if (this.dataset.stars === "ready") delete this.dataset.stars;
      } else {
        if (this.visible && !document.hidden && !this.paused)
          void this.startStars();
        this.starfield?.setActive(this.dataset.state === "running");
      }
      if (!this.button) return;
      this.button.hidden = this.motion.matches;
      this.button.setAttribute("aria-pressed", String(this.paused));
      this.button.setAttribute(
        "aria-label",
        this.paused
          ? "Reanudar animación de contacto"
          : "Pausar animación de contacto",
      );
      this.button.textContent = this.paused
        ? "Reanudar espacio ▷"
        : "Pausar espacio Ⅱ";
    };
  }
  if (!customElements.get("contact-cosmos"))
    customElements.define("contact-cosmos", ContactCosmos);
</script>

<style>
  contact-cosmos {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    overflow: hidden;
    pointer-events: none;
    background: #020304;
  }
  .cosmos-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .star-canvas {
    position: absolute;
    inset: 0;
  }
  .star-canvas :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
  contact-cosmos[data-stars="ready"] .star {
    visibility: hidden;
  }
  .star {
    position: absolute;
    border-radius: 50%;
    background: #f0f0eb;
  }
  button {
    position: absolute;
    right: 20px;
    bottom: 16px;
    pointer-events: auto;
    min-height: 32px;
    padding: 7px 12px;
    border: 1px solid #ffffff26;
    border-radius: 20px;
    background: #020304cc;
    color: #d0d0cb;
    font-size: 0.65rem;
  }
  @media (prefers-reduced-motion: reduce) {
    button {
      display: none;
    }
  }
</style>
