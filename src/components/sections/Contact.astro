---
import { profile } from "../../data/profile";
import ContactCosmos from '../visual/ContactCosmos.astro';
---

<section
  id="contacto"
  class="section contact"
  aria-labelledby="contact-title"
  style="position: relative; isolation: isolate; overflow: hidden;"
>
  <div class="contact-panel">
    <ContactCosmos />
    <p class="eyebrow">04 / Siguiente paso</p>
    <h2 id="contact-title">Algo bueno empieza<br />con una conversación.</h2>
    <p>Busco sumarme a nuevos retos.</p>
    <a
      class="button button-primary"
      href={profile.emailComposeUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-describedby="contact-mail-hint"
      >Escríbeme <span aria-hidden="true">↗</span></a
    >

    <div class="contact-links">
      {
        profile.socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-describedby={
              social.label === "Email" ? "contact-mail-hint" : undefined
            }
          >
            {social.label} ↗
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .contact { padding: 0; border-radius: 0; }
  .contact-panel { position: relative; isolation: isolate; overflow: hidden; background: #020304; border-radius: 0; padding: 100px 24px 90px; }
  .contact-panel > :not(contact-cosmos) { position: relative; z-index: 1; }
  .contact-panel .contact-mail-hint {
    margin: 12px 0 0;
    font-size: 0.72rem;
  }
</style>
