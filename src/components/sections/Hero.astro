---
import HeroPresentation from './HeroPresentation.astro';
import { profile } from '../../data/profile';
---
<section id="inicio" class="screen-panel hero-space" aria-labelledby="hero-title">
  <div class="hero-content wrap">
    <HeroPresentation />
  </div>
  <div class="hero-foot wrap">
      <span>{profile.location} <span aria-hidden="true">/</span> Trabajo remoto</span>
      <a href="#proyectos">Descubre los proyectos <span aria-hidden="true">↓</span></a>
  </div>
</section>
<style>
  .hero-space { display: flex; flex-direction: column; gap: 24px; --screen-bottom: max(12px, env(safe-area-inset-bottom)); }
  .hero-content { display: grid; align-items: center; flex: 1; min-width: 0; }
  .hero-foot { padding: 0; margin-top: auto; color: var(--muted); align-items: center; flex-shrink: 0; background: none; border: 0; box-shadow: none; }
  .hero-foot a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 760px) { .hero-space { gap: 16px; } .hero-foot { font-size: .58rem; gap: 12px; } }
</style>
