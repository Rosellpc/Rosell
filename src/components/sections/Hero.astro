---
import HeroPresentation from "./HeroPresentation.astro";
import { profile } from "../../data/profile";
---

<section class="hero hero-space" aria-labelledby="hero-title">
  <div class="hero-content wrap">
    <HeroPresentation />
    <div class="hero-foot">
      <span>{profile.location} <span aria-hidden="true">/</span> Trabajo remoto</span>
      <a href="#proyectos">Desplázate para descubrir <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<style>
  .hero-space { position: relative; display: block; padding: 0; min-height: auto; }
  .hero-content { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: 28px; padding: 145px 0 40px; }
  .hero-foot { padding-top: 0; color: var(--muted); }
  @media (max-width: 760px) {
    .hero-content { gap: 24px; padding: 115px 0 32px; }
    .hero-foot { align-items: end; line-height: 1.8; }
  }
</style>
