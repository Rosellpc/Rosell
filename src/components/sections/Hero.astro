---
import VortexCanvas from "../visual/VortexCanvas.astro";
import { profile } from "../../data/profile";
---

<section class="hero hero-space" aria-labelledby="hero-title">
  <div class="hero-universe"><VortexCanvas mode="hero" /></div>
  <div class="hero-content wrap">
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="status-dot" aria-hidden="true"></span>{profile.role}
    </p>
    <h1 id="hero-title">Ideas claras.<br /><span>Software que fluye.</span></h1>
    <p class="hero-description">
      Soy Rosell. Desarrollo aplicaciones para negocios y herramientas de uso
      diario con React, TypeScript y Python.
    </p>
    <div class="actions">
      <a class="button button-primary" href="#proyectos"
        >Ver proyectos <span aria-hidden="true">↗</span></a
      >
      <a class="button button-secondary" href="#contacto">Hablemos</a>
    </div>
  </div>
  <div class="hero-visual">
    <div class="visual-caption">
      <span>Estudio 01 — Espacio</span><a
        href="/lab/vortex/"
        aria-label="Explorar el laboratorio de vórtice"
        >Explorar <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="hero-foot">
    <span
      >{profile.location} <span aria-hidden="true">/</span> Trabajo remoto</span
    ><a href="#proyectos"
      >Desplázate para descubrir <span aria-hidden="true">↓</span></a>
  </div>
  </div>
</section>

<style>
  .hero-space { position: relative; isolation: isolate; display: block; padding: 0; min-height: 760px; min-height: max(760px, 100svh); background: #020304; }
  .hero-universe { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .hero-content { min-height: inherit; display: grid; grid-template-columns: 1.15fr 1fr; align-items: center; gap: 20px; padding-top: 175px; padding-bottom: 40px; }
  .hero-content { pointer-events: none; }
  .hero-copy { max-width: 630px; pointer-events: auto; }
  .hero-description { color: #b8bfce; }
  .hero-visual { align-self: end; padding-bottom: 24px; pointer-events: none; }
  .visual-caption a { pointer-events: auto; }
  .hero-foot { position: relative; z-index: 2; pointer-events: auto; }
  @media (max-width: 640px) {
    .hero-space { min-height: max(780px, 100svh); }
    .hero-content { display: flex; flex-direction: column; align-items: stretch; padding-top: 140px; gap: 24px; }
    .hero-visual { width: 100%; margin-top: auto; padding-top: 140px; padding-bottom: 0; }
    .hero-foot { padding-top: 12px; }
  }
</style>
