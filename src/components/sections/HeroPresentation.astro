---
import { profile } from '../../data/profile';
import LiquidGlassLink from '../ui/LiquidGlassLink.astro';
import HolographicPortrait from '../visual/HolographicPortrait.astro';
import ProfileDetails from './ProfileDetails.astro';
---
<div id="sobre-mi" class="hero-presentation">
  <div class="presentation-intro">
    <p class="eyebrow presentation-eyebrow">{profile.name} <span aria-hidden="true">/</span> {profile.role}</p>
    <h1 id="hero-title">Software útil.<br />IA con contexto.</h1>
    <p class="hero-description">{profile.intro}</p>
    <div class="hero-actions">
      <LiquidGlassLink href="#proyectos" label="Ver proyectos" />
      <ProfileDetails />
    </div>
  </div>
  <div class="presentation-portrait-area"><HolographicPortrait /></div>
</div>
<style>
  .hero-presentation { width: 100%; min-width: 0; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; gap: 24px; }
  .presentation-intro { min-width: 0; padding: 24px 0 24px 24px; }
  .presentation-eyebrow { display: flex; flex-wrap: wrap; gap: 8px 12px; margin-bottom: 24px; font-size: .6rem; letter-spacing: .15em; }
  h1 { font-size: clamp(2.8rem, 4vw, 3.8rem); line-height: 1.12; font-weight: 450; letter-spacing: -.045em; }
  .hero-description { max-width: 425px; margin-top: 24px; font-size: .95rem; line-height: 1.8; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 22px; margin-top: 26px; }
  .presentation-portrait-area { display: grid; place-items: center; min-width: 0; padding: 0 12px; }
  .presentation-portrait-area :global(holographic-portrait) { width: min(100%, 54svh, 500px); }
  @media (max-width: 900px) {
    .presentation-intro { padding-left: 0; }
    h1 { font-size: clamp(2.3rem, 4.5vw, 3.4rem); }
  }
  @media (max-width: 760px) {
    .hero-presentation { grid-template-columns: 1fr; gap: 4px; }
    .presentation-intro { padding: 0; }
    .presentation-eyebrow { font-size: .52rem; margin-bottom: 16px; gap: 8px; }
    h1 { font-size: clamp(2rem, 7.8vw, 3.4rem); }
    .hero-description { max-width: 460px; margin-top: 16px; font-size: .87rem; line-height: 1.65; }
    .hero-actions { margin-top: 16px; gap: 4px 16px; }
    .presentation-portrait-area { padding: 0; }
    .presentation-portrait-area :global(holographic-portrait) { width: min(100%, 26svh, 300px); }
  }
</style>
