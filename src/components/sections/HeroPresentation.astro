---
import { Image } from "astro:assets";
import portrait from "../../assets/profile/foto-profile.png";
import { profile } from "../../data/profile";
import LiquidGlassLink from "../ui/LiquidGlassLink.astro";
import HeroVideo from "../visual/HeroVideo.astro";
---

<article
  id="sobre-mi"
  class="hero-presentation hero-copy"
  aria-labelledby="hero-title"
>
  <div class="presentation-intro">
    <p class="eyebrow presentation-eyebrow">
      {profile.name}
      <span aria-hidden="true">/</span>
      {profile.role}
    </p>
    <h1 id="hero-title">Ideas claras Software que fluye.</h1>
    <p class="hero-description">
      Soy Rosell. Desarrollo aplicaciones para negocios y herramientas de uso
      diario con React, TypeScript y Python.
    </p>
    <div class="actions">
      <LiquidGlassLink href="#proyectos" label="Ver proyectos" />
    </div>

    <div class="presentation-portrait-area">
      <Image
        src={portrait}
        alt="Retrato de RosellPC"
        width={800}
        widths={[400, 640, 960, 1280]}
        sizes="(max-width: 480px) calc(100vw - 90px), (max-width: 760px) 360px, (max-width: 1100px) 34vw, 360px"
        format="webp"
        quality={85}
        loading="eager"
        fetchpriority="high"
        class="presentation-portrait"
      />
    </div>

    <div class="presentation-story">
      <div class="presentation-details">
        <div class="presentation-story-heading">
          <h2>Mi forma de trabajar</h2>
          <p class="presentation-principle">
            Entender primero. Construir con intención.
          </p>
        </div>
        <div class="presentation-story-copy">
          <p>
            Empiezo por entender lo que necesitas para crear una experiencia
            clara. Desde la interfaz hasta el backend, cuido los permisos, la
            persistencia y la integridad de los datos.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="presentation-animation">
    <HeroVideo />
  </div>

  <style>
    .presentation-animation {
      position: relative;
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      min-width: 0;
      width: 100%;
      aspect-ratio: 1;
      margin-top: 80px;
    }
    .hero-presentation {
      z-index: auto;
      width: 100%;
      min-width: 0;
      padding: 0;
      margin: 0;
      border: 0;
      background: transparent;
      box-shadow: none;
      scroll-margin-top: 125px;
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
    }
    .presentation-intro {
      grid-column: 1;
      grid-row: 1;
      padding: 48px 36px 44px 46px;
    }
    .hero-presentation .presentation-eyebrow {
      flex-wrap: wrap;
      row-gap: 8px;
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      margin-bottom: 26px;
      color: var(--muted);
    }
    .hero-presentation h1 {
      font-size: clamp(2.8rem, 4vw, 3.8rem);
      font-weight: 450;
      line-height: 1.12;
      letter-spacing: -0.045em;
      text-wrap: balance;
    }
    .hero-presentation h1 span {
      color: #a6a5a2;
    }
    .hero-description {
      max-width: 425px;
      margin-top: 24px;
      font-size: 0.95rem;
      line-height: 1.8;
      color: var(--muted);
    }
    .actions {
      margin-top: 26px;
    }
    .presentation-stack {
      margin-top: 32px;
    }
    .presentation-stack > p {
      font-family: var(--mono);
      font-size: 0.58rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .presentation-stack ul {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 14px 0 0;
      list-style: none;
    }
    .presentation-stack li {
      padding: 5px 11px;
      border: 1px solid var(--line);
      border-radius: 7px;
      background: #ffffff02;
      color: #bebebb;
      font-size: 0.66rem;
    }
    .presentation-portrait-area {
      grid-column: 2;
      grid-row: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 28px;
      min-width: 0;
      margin-left: 1px;
      padding: 40px 36px;
    }
    .presentation-portrait {
      display: block;
      width: min(100%, 360px);
      height: auto;
      aspect-ratio: 1;
      object-fit: cover;
      object-position: 50% 20%;
      filter: grayscale(1);
      border: 1px solid #ffffff20;
      border-radius: 50%;
      background: var(--surface);
      box-shadow: 0 12px 28px #00000024;
    }
    .portrait-action {
      justify-content: center;
      margin: 0;
    }
    .presentation-story {
      grid-column: 1 / -1;
      grid-row: 2;
      padding: 32px 46px 36px;
    }
    .presentation-details {
      min-width: 0;
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 40px;
    }
    .presentation-details h2 {
      font-family: var(--mono);
      font-size: 0.6rem;
      font-weight: 400;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .presentation-details p {
      margin-top: 16px;
      font-size: 0.85rem;
      line-height: 1.85;
      color: var(--muted);
    }
    .presentation-details .presentation-principle {
      max-width: 310px;
      margin-top: 16px;
      font-size: clamp(1.5rem, 2.3vw, 1.9rem);
      line-height: 1.3;
      letter-spacing: -0.035em;
      color: var(--text);
      text-wrap: balance;
    }
    .presentation-story-copy > p:first-child {
      margin-top: 0;
    }
    .presentation-details .presentation-values {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 0.72rem;
      color: #bebebb;
    }
    .presentation-certificates {
      margin-top: 20px;
    }
    .presentation-certificates :global(.liquid-glass-link) {
      font-size: 0.75rem;
      min-height: 44px;
      padding: 10px 18px;
    }
    @media (max-width: 1100px) {
      .presentation-intro {
        padding: 36px 24px 36px 30px;
      }
      .hero-presentation h1 {
        font-size: clamp(2.5rem, 4.5vw, 3.4rem);
      }
      .presentation-portrait-area {
        padding: 32px 24px;
      }
      .presentation-story {
        padding: 30px;
      }
      .presentation-details {
        gap: 28px;
      }
    }
    @media (max-width: 760px) {
      .presentation-animation {
        grid-column: 1;
        grid-row: 2;
        width: min(100%, 440px);
        justify-self: center;
        margin-top: 16px;
      }
      .hero-presentation {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto auto auto;
      }
      .presentation-intro {
        padding: 30px 24px 0;
      }
      .hero-presentation h1 {
        max-width: 520px;
        font-size: clamp(2.3rem, 8.8vw, 3.6rem);
      }
      .hero-presentation .presentation-eyebrow {
        font-size: 0.55rem;
        column-gap: 8px;
        margin-bottom: 24px;
      }
      .hero-description {
        font-size: 0.9rem;
        margin-top: 22px;
      }
      .presentation-portrait-area {
        grid-column: 1;
        grid-row: 2;
        margin-left: 0;
        padding: 32px 24px;
        gap: 24px;
      }
      .presentation-story {
        grid-column: 1;
        grid-row: 3;
        padding: 28px 24px;
      }
      .presentation-details {
        grid-template-columns: minmax(0, 1fr);
        gap: 24px;
      }
    }
  </style>
</article>
