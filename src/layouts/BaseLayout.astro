---
import '../styles/global.css';
import Sidebar from '../components/layout/Sidebar.astro';
import '../styles/sidebar.css';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; home?: boolean; }
const { home = false, title = `${profile.name} — Full Stack`, description = profile.description } = Astro.props;
---
<!doctype html>
<html lang="es" class:list={{ homepage: home }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Sidebar />
    <main id="contenido"><slot /></main>
  </body>
</html>
