---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ProjectImage from '../../components/ui/ProjectImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() {
  return (await getCollection('projects')).map(project => ({ params: { slug: project.id }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout title={`${project.data.title} — Rosell Puma`} description={project.data.description}>
  <article class="project-detail wrap">
    <a class="text-link" href="/#proyectos">← Volver a proyectos</a>
    <header><p class="eyebrow">{project.data.category}</p><h1>{project.data.title}</h1><p class="lead">{project.data.description}</p><ul class="tags">{project.data.technologies.map(tech => <li>{tech}</li>)}</ul></header>
    {(project.data.contribution || project.data.status) && <dl class="case-summary">
      {project.data.contribution && <div><dt>Mi aporte</dt><dd>{project.data.contribution}</dd></div>}
      {project.data.status && <div><dt>Estado</dt><dd>{project.data.status}</dd></div>}
    </dl>}
    <div class="actions">{project.data.repository && <a class="button button-secondary" href={project.data.repository}>Ver código ↗</a>}{project.data.demo && <a class="button button-primary" href={project.data.demo}>{project.data.demoLabel} ↗</a>}</div>
    {project.data.preview && <a href={project.data.preview} aria-label="Ver captura en tamaño completo"><ProjectImage src={project.data.preview} alt={project.data.previewAlt ?? project.data.title} detail /></a>}
    <div class="prose"><Content /></div>

  </article>
</BaseLayout>

<style>
.case-summary { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-block: 28px; padding-block: 22px; border-block: 1px solid var(--line); }
dt { font-size: .7rem; color: var(--muted); margin-bottom: 8px; }
dd { margin: 0; font-size: .9rem; line-height: 1.6; }
@media (max-width: 640px) { .case-summary { grid-template-columns: 1fr; gap: 18px; } }
</style>
